# FinEdge Frontend — Environment Configuration Template
# Copy this file to .env.local for local development

# API Gateway URL (single entry point for all backend services)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Feature flag: set to "false" to connect to Spring Boot services, "true" for offline mock mode
NEXT_PUBLIC_USE_MOCK=false

# JWT token storage keys
NEXT_PUBLIC_TOKEN_KEY=finedge_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=finedge_refresh_token

# Razorpay Test Credentials (replace with your keys if testing payment gateway)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
